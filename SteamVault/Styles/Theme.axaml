  </Styles.Resources>

  <!-- ══════════════════════════════════════════════════════════
       BUTTONS
       ══════════════════════════════════════════════════════════ -->

  <!-- Shared press language: every pressable element answers the pointer -->
  <Style Selector="Button.primary, Button.accent, Button.ghost, Button.action, Button.danger, Button.icon, Button.soft">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Accent = the one primary action per region. With no brand hue left, the CTA
       earns attention by being the brightest object on a black page: light fill,
       dark text, faint white bloom. Nothing else in the app is this bright. -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource SheenAccent}" />
    <Setter Property="Foreground" Value="#0A0A0B" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <!-- BoxShadow lives on the presenter — Button itself has no such property in Avalonia. -->
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 8 24 -12 #59FFFFFF" />
  </Style>
  <Style Selector="Button.accent:pointerover">
    <Setter Property="Background" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 10 28 -12 #80FFFFFF" />
  </Style>
  <Style Selector="Button.accent:pressed">
    <Setter Property="Background" Value="#C4C4CA" />
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter">
    <!-- Bloom dies on press: the object is pushed into the surface, so it stops casting -->
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>
  <Style Selector="Button.accent:disabled"><Setter Property="Opacity" Value="0.32" /></Style>

  <!-- Primary = strong secondary. Was "neutral high-contrast", but accent now owns
       light-on-dark, so this becomes the raised dark pill instead. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#26262C" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #14FFFFFF" />
  </Style>
  <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="#303038" /></Style>
  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.primary:disabled"><Setter Property="Opacity" Value="0.32" /></Style>

  <!-- Ghost = outlined secondary -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="#131315" />
    <Setter Property="Foreground" Value="#C8C8CE" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="BorderBrush" Value="#33333A" />
  </Style>
  <Style Selector="Button.ghost:pressed">
    <Setter Property="Background" Value="#151517" />
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>
  <Style Selector="Button.ghost:disabled"><Setter Property="Opacity" Value="0.32" /></Style>

  <!-- Soft = raised secondary, one surface step above the page -->
  <Style Selector="Button.soft">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="Foreground" Value="#D8D8DE" />
    <Setter Property="BorderBrush" Value="#35353D" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.soft:pointerover">
    <Setter Property="Background" Value="#26262C" />
    <Setter Property="Foreground" Value="#F0F0F2" />
  </Style>
  <Style Selector="Button.soft:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /></Style>

  <!-- Icon button: square, quiet, for toolbar affordances -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="#131315" />
    <Setter Property="Foreground" Value="#A2A2A9" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.icon:pointerover">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="BorderBrush" Value="#33333A" />
  </Style>
  <Style Selector="Button.icon:pressed"><Setter Property="RenderTransform" Value="scale(0.94)" /></Style>

  <Style Selector="Button.more">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#A2A2A9" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.more:pointerover">
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="BorderBrush" Value="#33333A" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#1E1416" />
    <Setter Property="Foreground" Value="#E88992" />
    <Setter Property="BorderBrush" Value="#3A2226" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="#2A181B" />
    <Setter Property="Foreground" Value="#E0575F" />
  </Style>
  <Style Selector="Button.danger:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /></Style>

  <!-- Action tile: big quick-action card -->
  <Style Selector="Button.action">
    <Setter Property="Background" Value="#151517" />
    <Setter Property="Foreground" Value="#E8E8EC" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,15" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.action:pointerover">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="Foreground" Value="#F0F0F2" />
  </Style>
  <Style Selector="Button.action:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /></Style>

  <!-- ══════════════════════════════════════════════════════════
       RAIL — active state = raised fill + bright text
       (left indicator bar is drawn in the view, not the template)
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="Button.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#90909A" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rail /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="Foreground" Value="#FAFAFA" />
  </Style>
  <Style Selector="Button.rail.active">
    <Setter Property="Foreground" Value="#F0F0F2" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.rail.active /template/ ContentPresenter">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="Foreground" Value="#F0F0F2" />
    <!-- The active row is the only lit surface in the rail -->
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #14FFFFFF" />
  </Style>
  <Style Selector="Button.rail.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#26262C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Rail glyph: inherits the button's foreground so it lights up with the row -->
  <Style Selector="Button.rail Path.glyph">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Fill" Value="#7A7A84" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Fill" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rail:pointerover Path.glyph">
    <Setter Property="Fill" Value="#E0E0E5" />
  </Style>
  <Style Selector="Button.rail.active Path.glyph">
    <Setter Property="Fill" Value="#C9C9CF" />
  </Style>

  <!-- Active-row indicator: 3px silver bar pinned to the rail's left edge -->
  <Style Selector="Button.rail Border.indicator">
    <Setter Property="Width" Value="3" />
    <Setter Property="CornerRadius" Value="0,2,2,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,7" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.rail.active Border.indicator">
    <Setter Property="Background" Value="#EDEDF0" />
    <!-- Bleeds light into the rail so the bar reads as emitting, not painted -->
    <Setter Property="BoxShadow" Value="0 0 12 0 #59FFFFFF" />
  </Style>

  <!-- Generic inline glyph for headers and buttons -->
  <Style Selector="Path.glyph">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Fill" Value="#A2A2A9" />
  </Style>

  <!-- Text safety: Russian labels are longer — never clip into neighboring tiles -->
  <Style Selector="TextBlock.hero">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxLines" Value="3" />
  </Style>
  <Style Selector="TextBlock.panel-title">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxLines" Value="2" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Buttons: allow multi-line Russian without crushing neighbors -->
  <Style Selector="Button.ghost, Button.accent, Button.primary, Button.soft, Button.danger, Button.action">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.action">
    <Setter Property="Padding" Value="8,10" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="Button.pill">
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Border.glass">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.stat">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.item">
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- Close buttons: glyph must paint even when Content is only a Path -->
  <Style Selector="Button.icon Path.glyph">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Fill" Value="#A2A2A9" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover Path.glyph">
    <Setter Property="Fill" Value="#FAFAFA" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#A2A2A9" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="Foreground" Value="#FAFAFA" />
  </Style>
  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="Foreground" Value="#F0F0F2" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       SEGMENTED CONTROL
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="Border.segment">
    <Setter Property="Background" Value="#0F0F11" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
    <!-- Recessed: the track sits below the page, the active pill rises out of it -->
    <Setter Property="BoxShadow" Value="inset 0 1 2 0 #40000000" />
  </Style>
  <Style Selector="Button.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#90909A" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="Foreground" Value="#FAFAFA" />
  </Style>
  <Style Selector="Button.pill.active /template/ ContentPresenter">
    <Setter Property="Background" Value="#2C2C33" />
    <Setter Property="Foreground" Value="#FAFAFA" />
  </Style>
  <Style Selector="Button.pill.active">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ToggleButton variant: same pill, but :checked carries the state instead of a binding -->
  <Style Selector="ToggleButton.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#90909A" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Foreground" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.pill /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ToggleButton.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="Foreground" Value="#FAFAFA" />
  </Style>
  <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#26262C" />
    <Setter Property="Foreground" Value="#F0F0F2" />
  </Style>
  <Style Selector="ToggleButton.pill:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2E2E36" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="ToggleButton.pill:checked">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A ghost chip that can be switched on (group selection) -->
  <Style Selector="Button.ghost.active /template/ ContentPresenter">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="BorderBrush" Value="#6C6C75" />
    <Setter Property="Foreground" Value="#F0F0F2" />
  </Style>
  <Style Selector="Button.ghost.active">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       FIELDS
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="ComboBox.field">
    <Setter Property="Background" Value="#141416" />
    <Setter Property="BorderBrush" Value="#2C2C33" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="MinHeight" Value="38" />
  </Style>
  <Style Selector="ComboBox.field:pointerover">
    <Setter Property="BorderBrush" Value="#3A3A42" />
  </Style>
  <Style Selector="ComboBox.field:focus">
    <Setter Property="BorderBrush" Value="#55555E" />
  </Style>

  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="#0F0F11" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="13,10" />
    <Setter Property="CaretBrush" Value="#EDEDF0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="SelectionBrush" Value="#26FFFFFF" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#33333A" />
    <Setter Property="Background" Value="#0F0F11" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#EDEDF0" />
    <Setter Property="Background" Value="#0F0F11" />
  </Style>
  <Style Selector="TextBox.field:focus-within /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#EDEDF0" />
    <Setter Property="Background" Value="#0F0F11" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       SURFACES
       Depth language: every raised surface gets a 1px top highlight
       (light reads as coming from above) plus a wide, very soft ambient
       shadow. That pair is what separates "material" from "flat rectangle".
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource SheenPanel}" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="0 -1 0 0 #0FFFFFFF, 0 16 40 -20 #C0000000" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="#151517" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BoxShadow" Value="0 -1 0 0 #0AFFFFFF, 0 8 20 -14 #B0000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card:pointerover">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="BorderBrush" Value="#33333A" />
  </Style>

  <Style Selector="Border.item">
    <Setter Property="Background" Value="#131315" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <!-- 1px lift on hover: the row rises toward the pointer instead of just tinting -->
  <Style Selector="Border.item:pointerover">
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="Background" Value="#17171A" />
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>

  <!-- KPI stat tile -->
  <Style Selector="Border.stat">
    <Setter Property="Background" Value="{StaticResource SheenPanel}" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16,15" />
    <Setter Property="BoxShadow" Value="0 -1 0 0 #0FFFFFFF, 0 16 40 -20 #C0000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.stat:pointerover">
    <Setter Property="BorderBrush" Value="#34343C" />
  </Style>

  <!-- .hero variant: the portfolio tile. Same geometry, lifted fill, brighter edge and
       a white bloom. Four identical tiles have no hierarchy; one lit tile creates it. -->
  <Style Selector="Border.stat.hero">
    <Setter Property="Background" Value="{StaticResource SheenHero}" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="BoxShadow" Value="0 -1 0 0 #1AFFFFFF, 0 16 44 -20 #C0000000, 0 0 34 -12 #33FFFFFF" />
  </Style>
  <Style Selector="Border.stat.hero:pointerover">
    <Setter Property="BorderBrush" Value="#4A4A52" />
  </Style>

  <!-- Icon chip inside a KPI tile -->
  <Style Selector="Border.staticon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="BorderBrush" Value="#35353D" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.modal">
    <Setter Property="Background" Value="#151517" />
    <Setter Property="BorderBrush" Value="#303038" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 32 80 0 #99000000, 0 2 0 0 #14FFFFFF" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style Selector="Border.selection-bar">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="BoxShadow" Value="inset 0 1 0 0 #14FFFFFF, 0 10 28 -16 #4DFFFFFF" />
  </Style>

  <Style Selector="Border.home-skin">
    <Setter Property="Background" Value="#131315" />
    <Setter Property="BorderBrush" Value="#26262C" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="translateY(0px)" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.home-skin:pointerover">
    <Setter Property="BorderBrush" Value="#3A3A42" />
    <Setter Property="Background" Value="#17171A" />
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="BorderBrush" Value="#303038" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,5" />
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="#1E1E22" />
    <Setter Property="BorderBrush" Value="#3A3A42" />
  </Style>

  <!-- Hairline divider -->
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="#1F1F24" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       TYPE
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#6C6C75" />
    <Setter Property="LetterSpacing" Value="0.9" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.hero">
    <Setter Property="FontSize" Value="27" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="LetterSpacing" Value="-0.5" />
  </Style>
  <Style Selector="TextBlock.sub">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#A2A2A9" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="640" />
    <!-- MaxWidth alone leaves the block Stretch-aligned, so the layout centres the
         clamped 640px inside the full column and the subtitle drifts right of the
         title it belongs to. Pinning Left keeps the two flush. -->
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="LetterSpacing" Value="-0.6" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Panel heading: sits above charts and lists -->
  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#FAFAFA" />
    <Setter Property="LetterSpacing" Value="-0.1" />
  </Style>
  <Style Selector="TextBlock.money">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.up">
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.down">
    <Setter Property="Foreground" Value="#E0575F" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#6C6C75" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       CONTROLS — recolored to brand, away from Fluent blue
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="BorderBrush" Value="#303038" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="#C8C8CE" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#1E1E22" />
  </Style>
  <Style Selector="MenuItem.danger"><Setter Property="Foreground" Value="#E88992" /></Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="#C8C8CE" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="CheckBox /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Background" Value="#0F0F11" />
    <Setter Property="BorderBrush" Value="#33333A" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.14" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
    <Setter Property="BorderBrush" Value="#6C6C75" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="#EDEDF0" />
    <Setter Property="BorderBrush" Value="#EDEDF0" />
  </Style>
  <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#FFFFFF" />
  </Style>
  <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
    <!-- Box is silver when checked, so the tick has to be the page black to be seen -->
    <Setter Property="Fill" Value="#0A0A0B" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="#EDEDF0" />
    <Setter Property="Background" Value="#1F1F24" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="ScrollBar">
    <Setter Property="Width" Value="9" />
    <Setter Property="Opacity" Value="0.45" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="{StaticResource EaseOut}" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ScrollBar:pointerover"><Setter Property="Opacity" Value="0.9" /></Style>
  <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True" /></Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#1B1B1F" />
    <Setter Property="BorderBrush" Value="#303038" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="#E8E8EC" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
</Styles>
