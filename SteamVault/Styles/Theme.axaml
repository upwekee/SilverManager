<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- ── Surfaces ───────────────────────────────────────────── -->
    <Color x:Key="Bg0">#0A0A0B</Color>
    <Color x:Key="Bg1">#0F0F11</Color>
    <Color x:Key="Bg2">#151517</Color>
    <Color x:Key="Bg3">#1B1B1F</Color>
    <Color x:Key="Bg4">#232328</Color>
    <Color x:Key="Border">#26262C</Color>
    <Color x:Key="BorderHi">#33333A</Color>

    <!-- ── Text ───────────────────────────────────────────────── -->
    <Color x:Key="Text">#FAFAFA</Color>
    <Color x:Key="TextDim">#A2A2A9</Color>
    <Color x:Key="TextMute">#6C6C75</Color>

    <!-- ── Accent: silver. The "brand" is light itself — the CTA is the brightest
         object on the page, and Hi/Lo are its lit and shaded faces. ───────── -->
    <Color x:Key="Accent">#EDEDF0</Color>
    <Color x:Key="AccentHi">#FFFFFF</Color>
    <Color x:Key="AccentLo">#C4C4CA</Color>
    <Color x:Key="AccentDim">#6C6C75</Color>
    <Color x:Key="AccentSoft">#1E1E22</Color>
    <Color x:Key="AccentEdge">#35353D</Color>

    <!-- ── Semantic. Ranked by brightness because there is no hue to rank by:
         success is pure white, warn is a step down, info a step below that.
         Danger keeps a hue on purpose — failure must not be missable. ────── -->
    <Color x:Key="Success">#FFFFFF</Color>
    <Color x:Key="SuccessSoft">#1E1E22</Color>
    <Color x:Key="Info">#A2A2A9</Color>
    <Color x:Key="Warn">#C9C9CF</Color>
    <Color x:Key="Danger">#E0575F</Color>

    <SolidColorBrush x:Key="BrushBg0" Color="{StaticResource Bg0}" />
    <SolidColorBrush x:Key="BrushBg1" Color="{StaticResource Bg1}" />
    <SolidColorBrush x:Key="BrushBg2" Color="{StaticResource Bg2}" />
    <SolidColorBrush x:Key="BrushBg3" Color="{StaticResource Bg3}" />
    <SolidColorBrush x:Key="BrushBg4" Color="{StaticResource Bg4}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource Border}" />
    <SolidColorBrush x:Key="BrushBorderHi" Color="{StaticResource BorderHi}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource Text}" />
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource TextDim}" />
    <SolidColorBrush x:Key="BrushTextMute" Color="{StaticResource TextMute}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="BrushAccentHi" Color="{StaticResource AccentHi}" />
    <SolidColorBrush x:Key="BrushAccentDim" Color="{StaticResource AccentDim}" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="{StaticResource AccentSoft}" />
    <SolidColorBrush x:Key="BrushAccentEdge" Color="{StaticResource AccentEdge}" />
    <!-- BrushAccent2 = neutral high-contrast (legacy alias) -->
    <SolidColorBrush x:Key="BrushAccent2" Color="{StaticResource Text}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="BrushMoney" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="BrushWarn" Color="{StaticResource Warn}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource Danger}" />

    <!-- ── Motion: strong custom curves, never the weak built-ins ── -->
    <SplineEasing x:Key="EaseOut" X1="0.23" Y1="1" X2="0.32" Y2="1" />
    <SplineEasing x:Key="EaseInOut" X1="0.77" Y1="0" X2="0.175" Y2="1" />

    <!-- ── Elevation ──────────────────────────────────────────── -->
    <LinearGradientBrush x:Key="SheenPanel" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#1A1A1D" />
      <GradientStop Offset="1" Color="#131316" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SheenAccent" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0F0F2" />
      <GradientStop Offset="1" Color="#C9C9CF" />
    </LinearGradientBrush>
    <!-- Hero KPI fill: a violet bloom in the top-left corner, fading to panel tone.
         Only the portfolio tile wears it, so the eye lands on money first. -->
    <LinearGradientBrush x:Key="SheenHero" StartPoint="0%,0%" EndPoint="85%,100%">
      <GradientStop Offset="0" Color="#1E1E22" />
      <GradientStop Offset="0.55" Color="#17171A" />
      <GradientStop Offset="1" Color="#131316" />
    </LinearGradientBrush>

    <!-- ── Icons (24x24 grid, solid shapes) ───────────────────── -->
    <StreamGeometry x:Key="IcoOverview">M3 3h8v8H3V3zm10 0h8v5h-8V3zM3 13h8v8H3v-8zm10 3h8v5h-8v-5zm0-6h8v4h-8v-4z</StreamGeometry>
    <StreamGeometry x:Key="IcoAccounts">M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm0 2c-3.9 0-7 2-7 4.5V21h14v-3.5C16 15 12.9 13 9 13zm8.5-2a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm.5 2c-1 0-1.9.2-2.7.5 1.7 1.1 2.7 2.6 2.7 4.3V21h4v-3c0-2.3-2.4-4-4-5z</StreamGeometry>
