    <StreamGeometry x:Key="IcoTransfer">M4 8h11V4.5L21 9l-6 4.5V10H4V8zm16 8H9v3.5L3 15l6-4.5V14h11v2z</StreamGeometry>
    <StreamGeometry x:Key="IcoStats">M4 20V10h4v10H4zm6 0V4h4v16h-4zm6 0v-7h4v7h-4z</StreamGeometry>
    <StreamGeometry x:Key="IcoDrops">M12 2c3.5 4.2 6 7.6 6 10.6A6 6 0 0 1 6 12.6C6 9.6 8.5 6.2 12 2z</StreamGeometry>
