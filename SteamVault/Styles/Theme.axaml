    <StreamGeometry x:Key="IcoCase">M9 2h6v2h3a2 2 0 0 1 2 2v3H4V6a2 2 0 0 1 2-2h3V2zm2 2h2V3h-2v1zM4 11h6v2h4v-2h6v9a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-9z</StreamGeometry>
    <StreamGeometry x:Key="IcoAlert">M12 2 1 21h22L12 2zm0 5 7.5 12h-15L12 7zm-1 4v4h2v-4h-2zm0 5v2h2v-2h-2z</StreamGeometry>
    <StreamGeometry x:Key="IcoUp">M12 5l7 8h-4v6h-6v-6H5l7-8z</StreamGeometry>
    <StreamGeometry x:Key="IcoDown">M12 19l-7-8h4V5h6v6h4l-7 8z</StreamGeometry>
